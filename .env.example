# Backend (export into the process; Spring Boot does not automatically load .env)
PORT=8080
BIND_ADDRESS=127.0.0.1
CORS_ORIGINS=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
CONTACT_FROM=
CONTACT_TO=
CAREERS_RECEIVER_EMAIL=
# Reviews: keys belong only on the backend. No VITE_ prefix for secrets.
REVIEWS_MODE=DEMO
GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=
SMS_ENABLED=false
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=
SMS_TO=
# Frontend public configuration (copy these into frontend/.env.local)
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=
VITE_WHATSAPP_NUMBER=
VITE_SITE_URL=
# Production defaults to /mediastris-website/. Use / for root-domain hosting.
VITE_BASE_PATH=/mediastris-website/
# Optional public HTTPS API origin (no path, no credentials). Never a secret.
VITE_API_BASE_URL=
VITE_REVIEWS_MODE=DEMO
# Production demos are hidden by default. Set true only for a labelled demonstration.
VITE_SHOW_DEMO_REVIEWS=false
